# =========================
# LLM API Key
# =========================
 # 示例配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here


# =========================
# JWT Config
# =========================

JWT_SECRET_KEY=replace_with_a_random_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60


# =========================
# Logging Config
# =========================

LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=logs/app.log



# =========================
# API Server Config
# =========================

API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true


# =========================
# CORS Config
# =========================

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*


# =========================
# Retrieval Confidence Guard Config
# =========================

ENABLE_CONFIDENCE_GUARD=true
CONFIDENCE_MIN_OVERLAP_COUNT=1
CONFIDENCE_CHECK_TOP_N=3

# 可选值：
# chroma：使用本地 Chroma
# milvus：使用 Milvus / Milvus Lite
VECTOR_DB=milvus


# =========================
# Milvus Config
# =========================

# 本地 Milvus Lite 文件模式
# 后续如果使用 Docker Milvus，可改成：
# MILVUS_URI=http://127.0.0.1:19530

MILVUS_CONNECTION_URI=http://127.0.0.1:19530
MILVUS_COLLECTION_NAME=enterprise_rag
MILVUS_DROP_OLD=true